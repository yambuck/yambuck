# Linux release build environment for Yambuck.
#
# Release binaries link against the glibc of the machine that builds them.
# Building on the oldest supported base (Ubuntu 22.04, glibc 2.35) keeps the
# release tarball's binary runnable on Ubuntu 22.04+, Linux Mint 21+,
# Debian 12+ and current Fedora/Arch. Driven by scripts/build-linux-release.mjs;
# see docs/RELEASE.md.
FROM docker.io/library/ubuntu:22.04

# Set by scripts/build-linux-release.mjs from .node-version and rust-toolchain.toml.
ARG NODE_VERSION
ARG RUST_VERSION

ENV DEBIAN_FRONTEND=noninteractive

RUN test -n "${NODE_VERSION}" && test -n "${RUST_VERSION}" \
    || { echo "Build this image with scripts/build-linux-release.mjs, which passes the pinned versions." >&2; exit 1; }

# librsvg2-bin (rsvg-convert) and zip: building the example-app.yambuck demo
# package (scripts/build-example-app-yambuck.sh). xdg-utils: kept in line with
# the other apps' release containers (Tauri tooling expects xdg-open).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        file \
        git \
        libgtk-3-dev \
        librsvg2-bin \
        librsvg2-dev \
        libssl-dev \
        libwebkit2gtk-4.1-dev \
        pkg-config \
        rsync \
        xdg-utils \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
        | tar -xJ -C /usr/local --strip-components=1

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain "${RUST_VERSION}" \
            --component clippy,rustfmt

COPY build-in-container.sh /usr/local/bin/build-in-container.sh
ENTRYPOINT ["/usr/local/bin/build-in-container.sh"]
