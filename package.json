{
  "name": "yambuck",
  "private": true,
  "description": "Repository scripts for Yambuck: the pre-submit checks and release tooling (the app itself lives in apps/yambuck-gui).",
  "type": "module",
  "scripts": {
    "typecheck": "npm --prefix apps/yambuck-gui run typecheck",
    "lint": "npm --prefix apps/yambuck-gui run lint",
    "check:structure": "node scripts/check-file-lines.mjs",
    "build": "npm --prefix apps/yambuck-gui run build",
    "release:linux": "node scripts/build-linux-release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:notes": "node scripts/release-notes-template.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:promote": "node scripts/promote-release.mjs"
  }
}
